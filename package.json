{
  "name": "integrated-archive",
  "version": "0.3.0",
  "description": "Archive notes instead of deleting them, with optional archive metadata.",
  "private": true,
  "license": "MIT",
  "repository": "github:0libote/integrated-archive",
  "packageManager": "bun@1.4.2",
  "type": "module",
  "scripts": {
    "dev": "bun esbuild.config.mjs",
    "build": "tsc --noEmit && bun esbuild.config.mjs production",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "lint": "eslint .",
    "version:check": "bun scripts/version.mjs --check",
    "bump": "bun scripts/version.mjs",
    "check": "bun run version:check && bun run build && bun run lint && bun test"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/node": "^22.15.17",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.4",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "globals": "^17.12.0",
    "jiti": "^2.7.0",
    "obsidian": "1.13.1",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "monkey-around": "3.0.0"
  }
}
